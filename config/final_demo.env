# The one fixed RouterTLN driving configuration, used for all graded runs (1/3/5 obstacles)
# and by run_demo.sh and runs/longrun/run.py. KEY=VALUE only (no quoting, no shell syntax).
# Source: experiments/berlin-endurance/scout-speed-plan.md (4.25 m/s first-lap plan).
EL_MAP_DIR=/workspace/maps/berlin
EL_LAP_PLANNING=true
EL_SIM_SECTION_SPEED_PROFILE=true
EL_SIM_RACE_ONLY=true
EL_SPEED_CAP=4.25
EL_RACE_LAP_SPEED=true
EL_RACE_SIGHT_SPEED=false
EL_RACE_EXIT_SPEED=false
EL_STRAIGHT_BOOST=false
EL_SIM_AVOID_MIN=2.7
EL_SIM_AVOID_MAX=3.0
EL_RACE_BRAKE_PREVIEW_S=0.18
EL_INFERENCE_DEVICE=cpu
EL_AVOID_CHECKPOINT=/workspace/models/avoid-corridor-v2.pt
EL_RACE_CHECKPOINT=/workspace/models/race-berlin-wsp.pt
